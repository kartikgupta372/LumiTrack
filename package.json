{
  "name": "lumitrack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000",
    "dev:backend": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:frontend3": "npm --prefix frontend3 run dev",
    "build:frontend3": "npm --prefix frontend3 run build",
    "dev:frontend2": "npm --prefix frontend2 run dev",
    "build:frontend2": "npm --prefix frontend2 run build",
    "build:frontend": "npm --prefix frontend run build"
  }
}
